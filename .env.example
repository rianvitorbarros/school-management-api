# MongoDB deve suportar transacoes (replica set/Atlas) para operacoes criticas
MONGO_URI=

JWT_SECRET=
GUARDIAN_JWT_SECRET=

# Segredo dedicado para HMAC de CPF, IP e User-Agent na auditoria.
# Use valor aleatorio longo e estavel; trocar o segredo quebra correlacao historica.
GUARDIAN_AUDIT_HASH_SECRET=

# Render normalmente usa um salto de proxy. Ajuste conforme a topologia real.
# Valores aceitos: numero de saltos, IP/CIDR ou loopback/linklocal/uniquelocal.
TRUST_PROXY=1
